# Deft framework: ignore local-only caches and scratch directories
.deft-cache/
vbrief/.eval/

# Ghostreader per-manuscript state
.ghostreader/

# SLizard audit cache — keep policy files trackable
.slizard/*
!.slizard/suppressions.yml
!.slizard/config.json
!.slizard/rules.yml

# Audit triage scratch (exports under history/audit-triage/ are committed)
.tmp/audit-triage/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/

# IDE
.vscode/
.idea/

# Secrets (track .example templates only)
secrets/*
!secrets/*.example

# Virtual envs
.venv/
venv/
