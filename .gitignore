*.pyo
*.egg-info/
dist/
build/
.eggs/

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/

# IDE
.vscode/
.idea/

# Secrets (track .example templates only)
secrets/*
!secrets/*.example

# Virtual envs
.venv/
venv/

