# LLM API keys for Ghostreader
# Copy this file to secrets/llm.env and fill in your keys.
# You only need the key(s) for the provider(s) you use.

# OpenAI (gpt-4o, o3, etc.)
OPENAI_API_KEY=

# Anthropic (claude-sonnet-4-20250514, claude-opus-4-20250514, etc.)
ANTHROPIC_API_KEY=

# xAI (grok-beta, grok-2, etc.)
XAI_API_KEY=

# Google (gemini-1.5-pro, gemini-2.5-pro, etc.)
GOOGLE_API_KEY=

# Ollama runs locally — no API key needed.
# Use model prefix "ollama:" in config.yaml, e.g. model: ollama:llama3
