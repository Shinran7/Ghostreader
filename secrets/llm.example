# LLM API keys for Ghostreader
# Copy to secrets/llm.env (gitignored) and fill in keys you use.
#
# Easiest: copy these two from Ghostwriter's .env:
#   C:\Users\shinr\Projects\Ghostwriter\.env
#   → FIREWORKS_API_KEY
#   → GEMINI_API_KEY
# into this project's secrets/llm.env
#
# Confirm ignored: git check-ignore -v secrets/llm.env

# OpenAI (gpt-4o, o3, o4, etc.)
OPENAI_API_KEY=

# Anthropic (claude-sonnet-4-20250514, etc. — still supported, not the default)
ANTHROPIC_API_KEY=

# xAI (grok-beta, grok-2, etc.)
XAI_API_KEY=

# Google Gemini (preferred name first; GOOGLE_API_KEY still works)
# Factory always passes api_key= with GEMINI preferred over GOOGLE.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Fireworks.ai (OpenAI-compatible)
# Valid: accounts/fireworks/models/minimax-m3
# Valid: fireworks:accounts/fireworks/models/glm-5p3
# Invalid: fireworks:minimax-m3  (must keep accounts/fireworks/ after optional prefix)
FIREWORKS_API_KEY=

# Ollama runs locally — no API key needed.
# Use model prefix "ollama:" in config.yaml, e.g. model: ollama:llama3
